{
  "manifest_version": 3,
  "name": "Visual AI Browser Agent",
  "version": "1.0.0",
  "description": "Production-Ready Visual AI Agent with sidepanel control & PII masking.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "offscreen",
    "sidePanel",
    "tabs",
    "idle",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Open Agent Control Panel"
  }
}
